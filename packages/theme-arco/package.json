{
  "name": "element-plus-theme-arco",
  "version": "1.0.0",
  "description": "Arco Design look & feel for Element Plus",
  "type": "module",
  "license": "MIT",
  "author": "xiaou66",
  "homepage": "https://github.com/xiaou66/element-plus-theme-arco#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaou66/element-plus-theme-arco.git",
    "directory": "packages/theme-arco"
  },
  "bugs": {
    "url": "https://github.com/xiaou66/element-plus-theme-arco/issues"
  },
  "keywords": [
    "element-plus",
    "arco-design",
    "vue",
    "theme",
    "css",
    "scss",
    "vite"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "src",
    "vite.mjs",
    "vite.d.ts"
  ],
  "main": "dist/index.css",
  "style": "dist/index.css",
  "unpkg": "dist/index.css",
  "jsdelivr": "dist/index.css",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": "./dist/index.css",
    "./dark": "./dist/dark.css",
    "./theme-chalk/*": "./dist/theme-chalk/*",
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.mjs"
    },
    "./var.scss": "./src/common/var.scss",
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/gen-arco-vars.mjs && node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "prepack": "node scripts/prepack.mjs"
  },
  "peerDependencies": {
    "element-plus": "~2.14.0",
    "vite": ">=5"
  },
  "devDependencies": {
    "@arco-design/web-vue": "2.59.0",
    "element-plus": "2.14.7",
    "sass": "1.106.1"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
